# =============================================================================
# NEXORA WEB PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Instructions:
# 1. Duplicate this file as '.env' in your project root:
#      cp .env.example .env
# 2. Replace the placeholder values below with your actual service credentials.
#
# NOTE: Never commit your real '.env' file or secret credentials to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon / Supabase via Prisma ORM)
# -----------------------------------------------------------------------------
# DATABASE_URL:
# Pooled connection string for serverless runtime queries.
# - If using Supabase: Use Port 6543 (Transaction pooler) with ?pgbouncer=true
#   Example: "postgresql://postgres.[REF]:[PASS]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# - If using Neon: Use pooled host (-pooler) with ?sslmode=require
#   Example: "postgresql://[USER]:[PASS]@[ENDPOINT]-pooler.[REGION].aws.neon.tech/[DB]?sslmode=require"
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL:
# Direct unpooled connection string (Port 5432).
# Used by Prisma CLI for running migrations and 'prisma db push'.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"


# -----------------------------------------------------------------------------
# 2. SUPABASE (Public Client, SSR Utilities & Media Storage)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL:
# Your Supabase Project URL (Dashboard -> Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY / PUBLISHABLE_KEY:
# Public anon / publishable key for client and server-side Supabase SDK.
# Safe to expose in browser bundles.
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_[TOKEN]"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_[TOKEN]"


# -----------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (Nexora Admin CMS)
# -----------------------------------------------------------------------------
# ADMIN_JWT_SECRET:
# Cryptographic secret key used to sign HMAC-SHA256 administrator session tokens.
# Generate via: openssl rand -base64 32
ADMIN_JWT_SECRET="replace-with-a-secure-random-32-byte-secret-key-for-nexora"

# ADMIN_DEFAULT_PASSWORD (Optional):
# Fallback password used only during initial 'bun run db:seed' when creating the
# default Super Admin account (admin@ajiet.edu.in). Defaults to: NexoraAdmin@2026!
# ADMIN_DEFAULT_PASSWORD="YourSecurePasswordHere"


# -----------------------------------------------------------------------------
# 4. SERVER RUNTIME & DEPLOYMENT (Optional / Docker)
# -----------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
HOSTNAME="0.0.0.0"
