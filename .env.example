# =============================================================================
# NEXORA WEB PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to '.env' or '.env.local' and populate with your credentials:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit your real '.env' file or production credentials to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL / Prisma ORM)
# -----------------------------------------------------------------------------
# DATABASE_URL: Pooled connection string (Port 6543 via PgBouncer/Supavisor).
# Used by @prisma/adapter-pg for serverless runtime queries.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct unpooled connection string (Port 5432).
# Used by Prisma CLI for migrations and schema introspection.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# 2. SUPABASE CLIENT & PUBLIC STORAGE
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL: Found in your Supabase Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Found in your Supabase Project Settings -> API -> Project API keys.
# Safe to expose in the browser for public assets and client operations.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_placeholder_anon_key"

# -----------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (Admin CMS)
# -----------------------------------------------------------------------------
# ADMIN_JWT_SECRET: High-entropy secret key used to sign HMAC-SHA256 session tokens.
# Generate a secure string via terminal: openssl rand -base64 32
ADMIN_JWT_SECRET="replace-with-a-secure-random-32-byte-secret-key-for-nexora"

# -----------------------------------------------------------------------------
# 4. SERVER & RUNTIME (Optional / Docker)
# -----------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
HOSTNAME="0.0.0.0"
